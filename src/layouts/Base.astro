---
// Базовый макет: оболочка документа и общие части сайта.
import '../styles/global.css'
import Header from '../components/Header'
import Footer from '../components/Footer.astro'
import LiveBackground from '../components/LiveBackground'
import Chatbot from '../components/Chatbot'

type Props = {
  title: string
  description: string
  /** Только для 404 — реальной страницы под этим URL нет, индексировать нечего. */
  noindex?: boolean
}

const { title, description, noindex = false } = Astro.props
const pathname = Astro.url.pathname
// У 404 нет своего настоящего URL — «/404/» ничего не значит для поисковика,
// поэтому canonical для неё ведёт на главную, а не на саму себя.
const canonicalURL = noindex ? new URL('/', Astro.site) : new URL(pathname, Astro.site)
const ogImageURL = new URL('/og-image.png', Astro.site)

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Невариум ЛАБ ИИ',
  description:
    'Лаборатория внедрения искусственного интеллекта в малый и средний бизнес: GPT-ассистенты, чат-боты, автоматизация, обучение команд.',
  url: 'https://nevarium-lab.ru',
  logo: new URL('/logo-mark.png', Astro.site).toString(),
  image: ogImageURL.toString(),
  email: 'nevarium-lab@yandex.com',
  telephone: '+7-921-008-16-06',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Витебский проспект, д. 41, к. 3, кв. 131',
    addressLocality: 'Санкт-Петербург',
    postalCode: '196244',
    addressCountry: 'RU',
  },
  sameAs: [
    'https://max.ru/join/4u3kB47o-53REUPLuMBIl2uHDiMAmAFto24mxJ1wgnk',
    'https://vk.ru/nevarium_lab',
  ],
}
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d1030" />
    {/*
      Тема до первой отрисовки — без мигания.
      is:inline обязателен: без него Astro превратит скрипт в отложенный модуль,
      и при загрузке в тёмной теме экран мигнёт белым.
      Раньше цвет строки браузера (theme-color) выставлял ThemeProvider уже
      после запуска React — теперь это делается здесь же, до первой отрисовки.
    */}
    <script is:inline>
      ;(function () {
        var t = 'dark'
        try {
          if (localStorage.getItem('nevarium-theme') === 'light') t = 'light'
        } catch (e) {
          /* приватный режим */
        }
        document.documentElement.setAttribute('data-theme', t)
        var m = document.querySelector('meta[name="theme-color"]')
        if (m) m.content = t === 'light' ? '#eef1fb' : '#0d1030'
      })()
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- Шрифты — self-hosted, см. src/styles/global.css -->

    {/* Open Graph — своя карточка на каждой странице, а не одна на весь сайт. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Невариум ЛАБ ИИ" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* Organization — на каждой странице: помогает поисковикам связать сайт
    с конкретным юрлицом (ИП), а не просто с доменным именем. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
    {/*
      Без JS блоки .reveal остались бы с opacity: 0, то есть страница была бы
      пустой. Раньше это было неважно (весь сайт рисовался джаваскриптом), но
      теперь HTML самодостаточен — и терять его из-за анимации появления глупо.
    */}
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>

    {/* Декоративный фон — грузится в простое, не задерживая страницу. */}
    <LiveBackground client:idle />

    {/* Текущий адрес приходит пропом: react-router больше нет. */}
    <Header pathname={pathname} client:load />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <Chatbot client:idle />

    {/*
      Замена React-компонента Reveal (он оборачивал контент ~54 раза и тянул
      React на каждую статичную страницу). Пороги те же, что были в компоненте.
    */}
    <script>
      const revealables = document.querySelectorAll('.reveal')

      if (!('IntersectionObserver' in window)) {
        revealables.forEach((el) => el.classList.add('is-visible'))
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              entry.target.classList.add('is-visible')
              io.unobserve(entry.target)
            })
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        )
        revealables.forEach((el) => io.observe(el))
      }
    </script>

    {/*
      Счётчики цифр — разгон от нуля при попадании во вьюпорте. Общий на весь
      сайт: используется и в блоке «Результаты в цифрах» (Stat.astro), и в
      панели внедрения в hero (HeroPanel.astro) — разметка одна и та же
      ([data-stat] + [data-stat-value]), поэтому один наблюдатель на оба места.
    */}
    <script>
      const stats = document.querySelectorAll<HTMLElement>('[data-stat]')

      if (stats.length) {
        const render = (el: HTMLElement, n: number) => {
          const out = el.querySelector('[data-stat-value]')
          if (out) {
            out.textContent =
              (el.dataset.prefix ?? '') + n.toLocaleString('ru-RU') + (el.dataset.suffix ?? '')
          }
        }

        if (!('IntersectionObserver' in window)) {
          // Без observer'а значение и так уже настоящее в HTML — трогать не нужно.
        } else {
          // Обнуляем до старта анимации — но только когда JS точно жив.
          stats.forEach((el) => render(el, 0))

          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return
                const el = entry.target as HTMLElement
                io.unobserve(el)

                const target = Number(el.dataset.value ?? 0)
                const t0 = performance.now()
                const dur = 1400

                const tick = (t: number) => {
                  const p = Math.min((t - t0) / dur, 1)
                  const eased = 1 - Math.pow(1 - p, 3)
                  render(el, Math.round(target * eased))
                  if (p < 1) requestAnimationFrame(tick)
                }
                requestAnimationFrame(tick)
              })
            },
            { threshold: 0.4 },
          )

          stats.forEach((el) => io.observe(el))
        }
      }
    </script>
  </body>
</html>
