---
// Счётчик, который анимируется от нуля при появлении во вьюпорте.
// Заменяет React-компонент Stat.tsx: ради четырёх цифр на главной тянуть
// React на всю страницу не нужно.
//
// В HTML сразу пишется настоящее значение, а не 0 — число видно поисковикам
// и тем, у кого не отработал JS. Наблюдатель, который обнуляет и разгоняет
// его обратно, общий на весь сайт и живёт в Base.astro (см. [data-stat]) —
// это тот же счётчик, что использует HeroPanel для метрик в hero.
type Props = {
  value: number
  prefix?: string
  suffix?: string
  label: string
}

const { value, prefix = '', suffix = '', label } = Astro.props
---

<div class="glass stat" data-stat data-value={value} data-prefix={prefix} data-suffix={suffix}>
  <div class="stat__value" data-stat-value>{prefix}{value.toLocaleString('ru-RU')}{suffix}</div>
  <div class="stat__label">{label}</div>
</div>
