---
// Счётчик, который анимируется от нуля при появлении во вьюпорте.
// Заменяет React-компонент Stat.tsx: ради четырёх цифр на главной тянуть
// React на всю страницу не нужно.
//
// Отличие от прежней версии: в HTML сразу пишется настоящее значение, а не 0.
// Так число видно поисковикам и тем, у кого не отработал JS. Скрипт обнуляет
// его и разгоняет обратно уже при прокрутке.
type Props = {
  value: number
  prefix?: string
  suffix?: string
  label: string
}

const { value, prefix = '', suffix = '', label } = Astro.props
---

<div class="glass stat" data-stat data-value={value} data-prefix={prefix} data-suffix={suffix}>
  <div class="stat__value">{prefix}{value.toLocaleString('ru-RU')}{suffix}</div>
  <div class="stat__label">{label}</div>
</div>

<script>
  const stats = document.querySelectorAll<HTMLElement>('[data-stat]')

  if (stats.length && 'IntersectionObserver' in window) {
    const render = (el: HTMLElement, n: number) => {
      const out = el.querySelector('.stat__value')
      if (out) {
        out.textContent =
          (el.dataset.prefix ?? '') + n.toLocaleString('ru-RU') + (el.dataset.suffix ?? '')
      }
    }

    // Обнуляем до старта анимации — но только когда JS точно жив.
    stats.forEach((el) => render(el, 0))

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          const el = entry.target as HTMLElement
          io.unobserve(el)

          const target = Number(el.dataset.value ?? 0)
          const t0 = performance.now()
          const dur = 1400

          const tick = (t: number) => {
            const p = Math.min((t - t0) / dur, 1)
            const eased = 1 - Math.pow(1 - p, 3)
            render(el, Math.round(target * eased))
            if (p < 1) requestAnimationFrame(tick)
          }
          requestAnimationFrame(tick)
        })
      },
      { threshold: 0.4 },
    )

    stats.forEach((el) => io.observe(el))
  }
</script>
