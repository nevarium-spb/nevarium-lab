---
// Услуги. Перенесено из src/legacy/pages/Services.tsx дословно.
// <Reveal> → class="reveal", <Link> → обычная ссылка.
import Base from '../layouts/Base.astro'
import { services } from '../data/content'

// Список услуг для поисковиков — по одному Service на каждую карточку ниже.
const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.short,
      provider: { '@type': 'ProfessionalService', name: 'Невариум ЛАБ ИИ' },
      areaServed: 'RU',
    },
  })),
}
---

<Base
  title="Услуги — Невариум ЛАБ ИИ"
  description="GPT-ассистенты, чат-боты, ИИ-контент, автоматизация в таблицах, визуал, обучение команд и разработка сайтов. Под ключ и по NDA."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(servicesSchema)} />
  <section class="page-hero">
    <div class="container">
      <div class="reveal">
        <span class="eyebrow">Услуги</span>
        <h1 class="h1">
          Десять точек, где ИИ <span class="text-grad">окупается быстрее всего</span>
        </h1>
        <p class="lead">
          Каждая услуга — законченное решение: настройка под ваш процесс, тестирование
          на ваших данных, обучение команды и передача под ключ. Всё под NDA.
          Никаких «дальше разберётесь сами».
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 1rem">
    <div class="container" style="display: flex; flex-direction: column; gap: 1.25rem">
      {
        services.map((s) => {
          const Icon = s.icon
          return (
          <div class="reveal" style="--reveal-delay: 0.05s">
            <article class="glass card" id={s.id}>
              <div class="grid-2" style="gap: 2rem; align-items: start">
                <div style="display: flex; flex-direction: column; gap: 0.9rem">
                  <div class="card__icon"><Icon /></div>
                  <h2 class="h3">{s.title}</h2>
                  <p>{s.full}</p>
                  <div class="glass" style="padding: 1rem 1.2rem; border-radius: 14px; font-size: 0.94rem">
                    <strong class="text-grad">Результат:</strong>{' '}
                    <span style="color: var(--ink-soft)">{s.result}</span>
                  </div>
                </div>
                <div>
                  <div style="font-weight: 800; font-size: 0.82rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 0.9rem">
                    Что входит
                  </div>
                  <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem">
                    {s.includes.map((item) => (
                      <li style="display: flex; gap: 0.6rem; color: var(--ink-soft); font-size: 0.95rem">
                        <span style="color: var(--cyan); font-weight: 800">✓</span>{item}
                      </li>
                    ))}
                  </ul>
                  <a href="/contact" class="btn btn--ghost" style="margin-top: 1.4rem">
                    Обсудить задачу <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </article>
          </div>
          )
        })
      }
    </div>
  </section>
</Base>
