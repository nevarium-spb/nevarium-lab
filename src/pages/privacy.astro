---
// Политика обработки персональных данных (152-ФЗ) — ОБЩАЯ для nevarium-lab.ru и
// nevarium-vizor.ru. Текст живёт в src/shared/privacy-policy.js — это копия
// файла из репозитория Визора (G:/nevarium_vizor/src/shared/, там же тесты).
// Здесь его НЕ правят: правка в Визоре, затем `npm run shared:sync` там.
// Эта страница отвечает только за оформление.
//
// Меняя поведение форм, чат-бота или каналов уведомлений — сверяйтесь с текстом
// политики: он обязан описывать то, что сайт делает на самом деле.
import Base from '../layouts/Base.astro'
import PdRequestForm from '../components/PdRequestForm'
import {
  POLICY_UPDATED,
  POLICY_SUMMARY,
  POLICY_HTML_BEFORE_FORM,
  POLICY_HTML_AFTER_FORM,
} from '../shared/privacy-policy.js'
---

<Base
  title="Политика обработки персональных данных — Невариум ЛАБ ИИ"
  description="Какие данные мы собираем через формы и чат, зачем, где храним и как их удалить."
>
  <section class="page-hero">
    <div class="container">
      <div class="reveal">
        <span class="eyebrow">Документы</span>
        <h1 class="h1">
          Политика обработки <span class="text-grad">персональных данных</span>
        </h1>
        <p class="lead">{POLICY_SUMMARY}</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 1rem">
    <div class="container">
      <div class="reveal">
        <article class="glass legal">
          <p class="legal__updated">Редакция от {POLICY_UPDATED}</p>

          <Fragment set:html={POLICY_HTML_BEFORE_FORM} />
          {/*
            client:load, не client:visible: та же причина, что и в
            ContactForm.tsx на /contact — форма работает с персональными
            данными, задержка гидратации не должна быть возможна в принципе.
          */}
          <PdRequestForm client:load />

          <Fragment set:html={POLICY_HTML_AFTER_FORM} />
        </article>
      </div>
    </div>
  </section>
</Base>
